# ==============================================================================
# F&R Family Hub — Environment Variables Template
# ==============================================================================

# App Base URL (e.g. http://localhost:1000 or https://your-domain.vercel.app)
NEXT_PUBLIC_APP_URL="http://localhost:1000"

# ------------------------------------------------------------------------------
# 1. Supabase & PostgreSQL (Vercel Integration Auto-Generated Variables)
# ------------------------------------------------------------------------------
# Supabase REST & Auth Keys (Otomatis dibuat oleh integrasi Vercel + Supabase)
SUPABASE_URL="https://your-project.supabase.co"
NEXT_PUBLIC_SUPABASE_URL="https://your-project.supabase.co"
SUPABASE_ANON_KEY="your-supabase-anon-key"
NEXT_PUBLIC_SUPABASE_ANON_KEY="your-supabase-anon-key"
SUPABASE_PUBLISHABLE_KEY="your-supabase-anon-key"
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY="your-supabase-anon-key"
SUPABASE_SECRET_KEY="your-supabase-service-role-key"
SUPABASE_JWT_SECRET="your-supabase-jwt-secret"

# PostgreSQL Direct Connection Strings (Vercel Storage Auto-Generated)
POSTGRES_URL="postgres://postgres.xxx:password@aws-0-ap-southeast-1.pooler.supabase.com:6543/postgres?sslmode=require&supa=base-pooler.x"
POSTGRES_PRISMA_URL="postgres://postgres.xxx:password@aws-0-ap-southeast-1.pooler.supabase.com:5432/postgres?sslmode=require&pgbouncer=true"
POSTGRES_URL_NON_POOLING="postgres://postgres.xxx:password@aws-0-ap-southeast-1.pooler.supabase.com:5432/postgres?sslmode=require"
POSTGRES_USER="postgres.xxx"
POSTGRES_HOST="aws-0-ap-southeast-1.pooler.supabase.com"
POSTGRES_PASSWORD="your-db-password"
POSTGRES_DATABASE="postgres"

# ------------------------------------------------------------------------------
# 2. Google Gemini AI (Google AI Studio - Free Tier)
# ------------------------------------------------------------------------------
GEMINI_API_KEY="AIzaSy..."

# ------------------------------------------------------------------------------
# 3. Telegram Bot API (@BotFather)
# ------------------------------------------------------------------------------
TELEGRAM_BOT_TOKEN="123456789:ABCdefGhIJKlmNoPQRsTUVwxyZ"
TELEGRAM_WEBHOOK_SECRET="your-custom-webhook-secret-token"

# ------------------------------------------------------------------------------
# 4. Google Cloud Service Account (Google Drive API & Google Sheets API)
# ------------------------------------------------------------------------------
GOOGLE_SERVICE_ACCOUNT_EMAIL="fnr-family-bot@your-project.iam.gserviceaccount.com"
GOOGLE_SERVICE_ACCOUNT_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\nMIIEvgIBADANBgkqhkiG9w0BAQEFAASCBKgwggSkAgEAAoIBAQC...\n-----END PRIVATE KEY-----\n"
GOOGLE_DRIVE_ROOT_FOLDER_ID="1a2b3c4d5e6f7g8h9i0jklmnopqrst"
GOOGLE_SHEETS_SPREADSHEET_ID="1A2B3C4D5E6F7G8H9I0JKLMNOPQRSTUVWXYZ"

# ------------------------------------------------------------------------------
# 5. WhatsApp Cloud API (Meta WhatsApp Business Platform)
# ------------------------------------------------------------------------------
WHATSAPP_ACCESS_TOKEN="EAA..."
WHATSAPP_PHONE_NUMBER_ID="123456789012345"
WHATSAPP_VERIFY_TOKEN="fnr_family_whatsapp_secret"

# ------------------------------------------------------------------------------
# 6. Cloudflare R2 Object Storage (Zero Egress Media & Vault Storage)
# ------------------------------------------------------------------------------
# Dapatkan di Cloudflare Dashboard -> R2 -> Manage R2 API Tokens
CLOUDFLARE_R2_ACCOUNT_ID="your_cloudflare_account_id"
CLOUDFLARE_R2_ACCESS_KEY_ID="your_r2_access_key_id"
CLOUDFLARE_R2_SECRET_ACCESS_KEY="your_r2_secret_access_key"
CLOUDFLARE_R2_BUCKET_NAME="fnr-family-media"
# Opsional: Custom Domain atau R2.dev Public URL untuk deliver foto struk publik (misal: https://pub-xxx.r2.dev)
CLOUDFLARE_R2_PUBLIC_URL="https://pub-xxx.r2.dev"


